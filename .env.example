# AI Operations & Workflow Automation Platform — environment template
# Copy to .env (git-ignored) and edit. Everything works WITHOUT any of this:
# the default is mock mode — deterministic, offline, zero API keys.
#
# cp .env.example .env

# ---------------------------------------------------------------- runtime
# mock : deterministic rule-based pipeline, no network (default)
# live : every LLM call goes through the OpenAI-compatible gateway below
AIOPS_MODE=mock

# ------------------------------------------------------- live LLM settings
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter,
# Together, local vLLM...). OPENAI_API_KEY is required when AIOPS_MODE=live.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AIOPS_CHAT_MODEL=gpt-4o-mini
AIOPS_EMBED_MODEL=text-embedding-3-small

# ------------------------------------------------------------- governance
# Human-in-the-loop thresholds. Changing these is a governance decision,
# not a tuning knob — see docs/GOVERNANCE.md.
AIOPS_AUTO_EXECUTE_MAX_RISK=0.30
AIOPS_MONETARY_APPROVAL_LIMIT_USD=500
AIOPS_MIN_RETRIEVAL_SCORE=0.15
AIOPS_MIN_AUTO_CONFIDENCE=0.75

# -------------------------------------------------------------- security
# All three protections are OFF by default; enable in shared deployments.
# API key for /api/* when set (dashboard prompts the operator for it).
AIOPS_API_KEY=
# HMAC secret for POST /api/tickets/signed (n8n bridge). Shared with the
# workflow's HTTP Request node header. Empty = signature not required.
AIOPS_WEBHOOK_SECRET=
# Max clock skew (seconds) tolerated between X-Aiops-Timestamp and now.
AIOPS_WEBHOOK_MAX_SKEW=300
# Requests per window per client IP (0 disables the limiter).
AIOPS_RATE_LIMIT=0
AIOPS_RATE_WINDOW=60

# ---------------------------------------------------------------- server
AIOPS_DATA_DIR=./data
AIOPS_DASHBOARDS_URL=http://localhost:3000
# Set to a filesystem path to emit one JSON line per request (structured logs).
AIOPS_REQUEST_LOG_FILE=

# ------------------------------------------------------------------ ops
# Backup snapshot destination (scripts/backup.py). Empty = ./data_backups.
AIOPS_BACKUP_DIR=
